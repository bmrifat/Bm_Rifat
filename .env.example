# Public configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ANALYTICS_DOMAIN="bmrifat.com"

# Email Delivery (Resend)
RESEND_API_KEY="re_..."
CONTACT_TO_EMAIL="rifat@example.com"
CONTACT_FROM_EMAIL="contact@bmrifat.com"

# Cloudflare Turnstile (Spam prevention)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# Upstash Redis (Optional rate limiting, in-memory fallback included)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
